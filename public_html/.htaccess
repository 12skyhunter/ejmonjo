<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /ejmonjo/

  # Si el archivo o directorio existe físicamente, servirlo directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Mapeo limpio de URLs sin extensión (ej: /ejmonjo/contacto -> contacto.html)
  RewriteCond %{DOCUMENT_ROOT}/ejmonjo/$1.html -f [OR]
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([a-zA-Z0-9_-]+)$ $1.html [L,QSA]

  # Fallback 404
  ErrorDocument 404 /ejmonjo/404.html
</IfModule>

# Deshabilitar caché agresiva para scripts y HTML en desarrollo
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
